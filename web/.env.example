# Copy to .env (deploy/deploy.sh generates one with random secrets on first deploy).
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_ALLOWED_HOSTS=moon.example.org,localhost,127.0.0.1
MOON_PUBLIC_URL=https://moon.example.org
POSTGRES_DB=moon
POSTGRES_USER=moon
POSTGRES_PASSWORD=change-me
MOON_TIME_ZONE=Europe/Moscow
MOON_TRUST_X_REAL_IP=1
MOON_WEB_PORT=8710
# MOON_VERIFICATION_KEY must equal core/Integrity.KEY in the checker build.
# MOON_VERIFICATION_KEY=moon-cs2-2026::integrity::v1
