msgstr "Аккаунты, входившие на этом ПК, и их VAC-баны."

#: checks/templatetags/moon.py
msgid "Autostart"
msgstr "Автозапуск"

#: checks/templatetags/moon.py
msgid "Background information; it does not affect the result."
msgstr "Справочные сведения; на итог не влияют."

#: checks/templatetags/moon.py
