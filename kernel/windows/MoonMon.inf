; MoonMon.inf — install information for the MoonMon kernel driver (cs2-moon.ru)
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
DriverVer   = 09/14/2026,1.0.0.0
CatalogFile = MoonMon.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12   ; %windir%\System32\drivers

[DefaultInstall.NTamd64]
CopyFiles = MoonMon.Files

[DefaultInstall.NTamd64.Services]
AddService = MoonMon,,MoonMon.Service

[MoonMon.Service]
DisplayName   = "Moon Kernel Monitor"
ServiceType   = 1   ; SERVICE_KERNEL_DRIVER
StartType     = 3   ; SERVICE_DEMAND_START
ErrorControl  = 1
ServiceBinary = %12%\MoonMon.sys

[MoonMon.Files]
MoonMon.sys

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
MoonMon.sys = 1

[Strings]
Provider = "cs2-moon.ru"
DiskName = "MoonMon Install Disk"
