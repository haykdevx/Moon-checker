msgstr "Вход по резервному коду. Осталось: %(left)s — скоро создайте новые."

#: accounts/views.py
msgid "That code does not match. Check the phone's clock and try again."
msgstr "Код не подошёл. Проверьте время на телефоне и попробуйте ещё раз."

#: accounts/views.py
msgid "That code is not valid."
msgstr "Код неверный."

#: accounts/views.py
msgid "That would leave the panel without an active owner."
msgstr "Так панель останется без активного владельца."

#: accounts/views.py
